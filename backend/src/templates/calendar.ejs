<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agenda EJP – Mai 2026</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
  </style>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --color-mpi: #2563EB;
      --color-mpi-light: #DBEAFE;
      --color-staff: #16A34A;
      --color-staff-light: #DCFCE7;
      --color-ejp: #7C3AED;
      --color-ejp-light: #EDE9FE;
      --color-bg: #F8FAFC;
      --color-card: #FFFFFF;
      --color-border: #E5E7EB;
      --color-text: #111827;
      --color-text-muted: #6B7280;
      --color-today-bg: #FFF7ED;
      --color-today-border: #F97316;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04);
      --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.04);
      --radius: 12px;
      --radius-sm: 6px;
      --radius-xs: 4px;
    }

    html, body {
      font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      font-size: 13px;
      line-height: 1.4;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ─── PAGE WRAPPER ─── */
    .page-wrapper {
      width: 297mm;
      min-height: 210mm;
      margin: 0 auto;
      padding: 0;
      background: var(--color-bg);
    }

    /* ─── HEADER ─── */
    .header {
      background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 45%, #7C3AED 100%);
      padding: 28px 36px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: 0 0 var(--radius) var(--radius);
      margin-bottom: 20px;
      box-shadow: var(--shadow-lg);
      position: relative;
      overflow: hidden;
    }

    .header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .header-left { position: relative; }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      color: #BFDBFE;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 20px;
      margin-bottom: 10px;
    }

    .header-badge::before {
      content: '📅';
      font-size: 12px;
    }

    .header-title {
      font-size: 32px;
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: -0.5px;
      line-height: 1.1;
      margin-bottom: 6px;
      text-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    .header-subtitle {
      font-size: 18px;
      font-weight: 400;
      color: rgba(255,255,255,0.8);
      letter-spacing: 0.02em;
    }

    .header-right {
      position: relative;
      text-align: right;
    }

    .header-month-big {
      font-size: 64px;
      font-weight: 800;
      color: rgba(255,255,255,0.12);
      line-height: 1;
      letter-spacing: -3px;
      user-select: none;
    }

    .header-stats {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 8px;
    }

    .header-stat {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 6px 12px;
      text-align: center;
    }

    .header-stat-value {
      font-size: 18px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .header-stat-label {
      font-size: 10px;
      color: rgba(255,255,255,0.65);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* ─── MAIN CONTENT ─── */
    .main-content {
      padding: 0 20px 20px;
    }

    /* ─── CALENDAR SECTION ─── */
    .calendar-section {
      background: var(--color-card);
      border-radius: var(--radius);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      overflow: hidden;
      margin-bottom: 20px;
    }

    /* ─── DAY HEADERS ─── */
    .calendar-header-row {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      border-bottom: 2px solid var(--color-border);
    }

    .calendar-day-header {
      padding: 10px 0;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
      background: #F9FAFB;
    }

    .calendar-day-header:nth-child(1) { color: #EF4444; } /* Dim */
    .calendar-day-header:nth-child(7) { color: #EF4444; } /* Sam */

    /* ─── CALENDAR GRID ─── */
    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
    }

    /* ─── DAY CELL ─── */
    .day-cell {
      min-height: 90px;
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      padding: 6px 6px 4px;
      position: relative;
      background: var(--color-card);
      transition: background 0.15s;
    }

    .day-cell:nth-child(7n) { border-right: none; }
    .day-cell.empty { background: #FAFAFA; }

    .day-cell.today {
      background: var(--color-today-bg);
    }

    .day-cell.today .day-number {
      background: var(--color-today-border);
      color: #FFFFFF;
    }

    /* Weekend columns: 1st (Sun) and 7th (Sat) */
    .day-cell.weekend { background: #FAFAFA; }
    .day-cell.weekend.today { background: #FFF7ED; }

    .day-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text);
      float: right;
      margin-bottom: 4px;
    }

    /* ─── EVENT CARDS ─── */
    .event-card {
      display: block;
      border-left: 3px solid;
      border-radius: var(--radius-xs);
      padding: 3px 5px;
      margin-bottom: 3px;
      font-size: 10px;
      line-height: 1.3;
      overflow: hidden;
      cursor: default;
      box-shadow: var(--shadow-sm);
    }

    .event-card.cat-mpi {
      border-left-color: var(--color-mpi);
      background: var(--color-mpi-light);
    }

    .event-card.cat-staff {
      border-left-color: var(--color-staff);
      background: var(--color-staff-light);
    }

    .event-card.cat-ejp {
      border-left-color: var(--color-ejp);
      background: var(--color-ejp-light);
    }

    .event-title {
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .event-card.cat-mpi .event-title { color: #1D4ED8; }
    .event-card.cat-staff .event-title { color: #15803D; }
    .event-card.cat-ejp .event-title { color: #6D28D9; }

    .event-time {
      font-size: 9px;
      font-weight: 400;
      display: block;
      margin-top: 1px;
      opacity: 0.75;
    }

    .event-card.cat-mpi .event-time { color: #1E40AF; }
    .event-card.cat-staff .event-time { color: #166534; }
    .event-card.cat-ejp .event-time { color: #5B21B6; }

    .overflow-badge {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      background: #F3F4F6;
      border: 1px solid #D1D5DB;
      color: #6B7280;
      font-size: 9px;
      font-weight: 600;
      padding: 2px 5px;
      border-radius: 10px;
      cursor: default;
      margin-top: 2px;
    }

    /* ─── FOOTER LEGEND ─── */
    .footer-section {
      display: flex;
      align-items: flex-start;
      gap: 24px;
      background: var(--color-card);
      border-radius: var(--radius);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
      padding: 14px 20px;
      margin-bottom: 20px;
    }

    .legend-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-right: 8px;
      white-space: nowrap;
      padding-top: 2px;
    }

    .legend-items {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      font-weight: 500;
      color: var(--color-text);
    }

    .legend-dot {
      width: 12px;
      height: 12px;
      border-radius: 3px;
      flex-shrink: 0;
    }

    .legend-dot.mpi { background: var(--color-mpi); }
    .legend-dot.staff { background: var(--color-staff); }
    .legend-dot.ejp { background: var(--color-ejp); }

    /* ─── EVENTS DETAIL LIST ─── */
    .detail-section {
      background: var(--color-card);
      border-radius: var(--radius);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      overflow: hidden;
    }

    .detail-header {
      background: linear-gradient(135deg, #F9FAFB 0%, #F3F4F6 100%);
      border-bottom: 1px solid var(--color-border);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .detail-header-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--color-text);
    }

    .detail-header-count {
      font-size: 11px;
      font-weight: 500;
      color: var(--color-text-muted);
      background: #E5E7EB;
      padding: 2px 8px;
      border-radius: 20px;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
    }

    .detail-table thead tr {
      background: #F9FAFB;
    }

    .detail-table th {
      padding: 8px 14px;
      text-align: left;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      border-bottom: 1px solid var(--color-border);
    }

    .detail-table td {
      padding: 9px 14px;
      border-bottom: 1px solid #F3F4F6;
      vertical-align: middle;
    }

    .detail-table tr:last-child td { border-bottom: none; }
    .detail-table tbody tr:hover { background: #FAFAFA; }

    .detail-cat-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 600;
    }

    .detail-cat-badge.mpi { background: var(--color-mpi-light); color: #1D4ED8; }
    .detail-cat-badge.staff { background: var(--color-staff-light); color: #15803D; }
    .detail-cat-badge.ejp { background: var(--color-ejp-light); color: #6D28D9; }

    .detail-date {
      font-weight: 600;
      font-size: 12px;
      color: var(--color-text);
      white-space: nowrap;
    }

    .detail-title-text {
      font-weight: 500;
      font-size: 12px;
      color: var(--color-text);
    }

    .detail-time-text {
      font-size: 11px;
      color: var(--color-text-muted);
      white-space: nowrap;
    }

    .detail-desc-text {
      font-size: 11px;
      color: var(--color-text-muted);
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ─── PRINT STYLES ─── */
    @media print {
      @page {
        size: A4 landscape;
        margin: 0;
      }

      html, body {
        width: 297mm;
        height: 210mm;
      }

      .page-wrapper {
        width: 297mm;
      }

      .day-cell { break-inside: avoid; }
      .detail-section { break-inside: avoid; }
    }

    /* Empty state */
    .no-events {
      text-align: center;
      padding: 32px;
      color: var(--color-text-muted);
      font-size: 13px;
    }

    .no-events-icon { font-size: 32px; margin-bottom: 8px; display: block; }
  </style>
</head>
<body>
<div class="page-wrapper">

  <!-- ══════════ HEADER ══════════ -->
  <div class="header">
    <div class="header-left">
      <div class="header-badge">Agenda officiel</div>
      <h1 class="header-title">Programmes EJP – Cotonou</h1>
      <p class="header-subtitle">MPI / STAFF – Mai 2026</p>
    </div>
    <div class="header-right">
      <div class="header-month-big">MAI</div>
      <div class="header-stats">
        <div class="header-stat">
          <div class="header-stat-value"><%= meta.totalEvents %></div>
          <div class="header-stat-label">Événements</div>
        </div>
        <div class="header-stat">
          <div class="header-stat-value">31</div>
          <div class="header-stat-label">Jours</div>
        </div>
        <div class="header-stat">
          <div class="header-stat-value">2026</div>
          <div class="header-stat-label">Année</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════ MAIN CONTENT ══════════ -->
  <div class="main-content">

    <!-- ── Calendar Section ── -->
    <div class="calendar-section">
      <!-- Day headers -->
      <div class="calendar-header-row">
        <% daysOfWeek.forEach(function(d) { %>
          <div class="calendar-day-header"><%= d %></div>
        <% }); %>
      </div>

      <!-- Calendar grid -->
      <div class="calendar-grid">
        <% weeks.forEach(function(week) { %>
          <% week.forEach(function(cell, colIdx) { %>
            <%
              const isWeekend = colIdx === 0 || colIdx === 6;
              let cellClass = 'day-cell';
              if (cell.empty) cellClass += ' empty';
              if (cell.isToday) cellClass += ' today';
              if (isWeekend && !cell.empty) cellClass += ' weekend';
            %>
            <div class="<%= cellClass %>">
              <% if (!cell.empty) { %>
                <span class="day-number"><%= cell.day %></span>

                <div style="clear:both; padding-top: 2px;">
                  <% cell.visible.forEach(function(evt) { %>
                    <%
                      const catClass = evt.category.toLowerCase();
                    %>
                    <div class="event-card cat-<%= catClass %>">
                      <span class="event-title"><%= evt.title %></span>
                      <% if (evt.timeStr) { %>
                        <span class="event-time">⏰ <%= evt.timeStr %></span>
                      <% } else { %>
                        <span class="event-time">Toute la journée</span>
                      <% } %>
                    </div>
                  <% }); %>

                  <% if (cell.overflow > 0) { %>
                    <span class="overflow-badge">+<%= cell.overflow %> autre<%= cell.overflow > 1 ? 's' : '' %></span>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% }); %>
        <% }); %>
      </div>
    </div>

    <!-- ── Legend / Footer ── -->
    <div class="footer-section">
      <span class="legend-title">Légende :</span>
      <div class="legend-items">
        <div class="legend-item">
          <span class="legend-dot mpi"></span>
          <span>MPI</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot staff"></span>
          <span>STAFF</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot ejp"></span>
          <span>EJP</span>
        </div>
      </div>
    </div>

    <!-- ── Detailed Events List ── -->
    <div class="detail-section">
      <div class="detail-header">
        <span class="detail-header-title">Détail des événements</span>
        <span class="detail-header-count"><%= meta.totalEvents %> événement<%= meta.totalEvents !== 1 ? 's' : '' %></span>
      </div>

      <% if (allEventsList.length === 0) { %>
        <div class="no-events">
          <span class="no-events-icon">📭</span>
          Aucun événement trouvé pour Mai 2026 dans ce fichier ICS.
        </div>
      <% } else { %>
        <table class="detail-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Catégorie</th>
              <th>Titre</th>
              <th>Horaire</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% allEventsList.forEach(function(evt) { %>
              <%
                const catClass = evt.category.toLowerCase();
                const dayNames = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
                // Compute weekday for this day of May 2026
                // May 1 = Friday = index 5 (0=Sun)
                const dow = (5 + evt.day - 1) % 7;
                const dayLabel = dayNames[dow];
              %>
              <tr>
                <td>
                  <span class="detail-date">
                    <%= dayLabel %> <%= String(evt.day).padStart(2,'0') %> mai 2026
                  </span>
                </td>
                <td>
                  <span class="detail-cat-badge <%= catClass %>"><%= evt.category %></span>
                </td>
                <td>
                  <span class="detail-title-text"><%= evt.title %></span>
                </td>
                <td>
                  <span class="detail-time-text">
                    <% if (evt.timeStr) { %><%= evt.timeStr %><% } else { %>Journée entière<% } %>
                  </span>
                </td>
                <td>
                  <span class="detail-desc-text"><%= evt.description || '—' %></span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

  </div><!-- /main-content -->
</div><!-- /page-wrapper -->
</body>
</html>
